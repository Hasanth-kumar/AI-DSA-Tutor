{
  "name": "@dsa/integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "db:seed": "tsx src/scripts/from-notion.ts",
    "db:seed-cards": "tsx src/scripts/seed-cards.ts",
    "db:embed-cards": "tsx src/scripts/embed-cards.ts",
    "db:dedupe-problems": "tsx src/scripts/dedupe-notion-problems.ts"
  },
  "dependencies": {
    "@dsa/database": "workspace:*",
    "@dsa/intelligence": "workspace:*",
    "@dsa/shared": "workspace:*",
    "@notionhq/client": "^2.2.15",
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "drizzle-orm": "^0.39.3",
    "js-yaml": "^4.1.0",
    "p-queue": "^8.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
