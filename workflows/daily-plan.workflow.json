{
  "name": "DSA Daily Plan → WhatsApp",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "cron-daily-plan",
      "name": "Every day 7 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:3000/api/notifications/daily-plan",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Notify-Secret",
              "value": "={{ $env.WHATSAPP_NOTIFY_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-daily-plan",
      "name": "Send daily plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    }
  ],
  "connections": {
    "Every day 7 AM": {
      "main": [[{ "node": "Send daily plan", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
