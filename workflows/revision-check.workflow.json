{
  "name": "DSA Revision Check → WhatsApp",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 21 * * *"
            }
          ]
        }
      },
      "id": "cron-revision",
      "name": "Every day 9 PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:3000/api/notifications/revision-check",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Notify-Secret",
              "value": "={{ $env.WHATSAPP_NOTIFY_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-revision",
      "name": "Send revision reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    }
  ],
  "connections": {
    "Every day 9 PM": {
      "main": [[{ "node": "Send revision reminder", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
