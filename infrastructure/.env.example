# Personal single-user setup — one Notion workspace, one WhatsApp recipient, one SQLite file.
# Copy to repo root as `.env` and fill in your values.

# Notion
NOTION_TOKEN=secret_xxx
NOTION_TOPICS_DB_ID=xxx
NOTION_PROBLEMS_DB_ID=xxx
NOTION_SESSIONS_DB_ID=xxx
# Optional — card bank sync (§8). Without this, cards export to CARDS_EXPORT_DIR.
NOTION_CARDS_DB_ID=
CARDS_EXPORT_DIR=./data/cards-export
CARDS_SYNC_FLUSH_INTERVAL_MS=300000

# Backend
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# LLM — OpenRouter
# General key — used for OPENROUTER_MODEL (e.g. Gemma 4 free)
OPENROUTER_API_KEY=
# Coach key — used for COACH_LLM_MODEL, WARMUP_LLM_MODEL, and coach picker entries for those models
OPENROUTER_COACH_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
WARMUP_LLM_MODEL=openai/gpt-oss-20b:free
COACH_LLM_MODEL=openai/gpt-oss-120b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=DSA Mastery OS

# WhatsApp (Meta Cloud API) — Phase 3
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_RECIPIENT=
WHATSAPP_API_VERSION=v21.0
# Comma-separated wa_ids allowed to run bot commands (empty = all)
WHATSAPP_ALLOWED_RECIPIENTS=
# Secures POST /api/notifications/* when using n8n cron
WHATSAPP_NOTIFY_SECRET=

# SQLite
SQLITE_PATH=./data/sqlite/dsa.db

# Obsidian vault (optional)
OBSIDIAN_VAULT_PATH=

# Intelligence engine weights (tunable)
WEIGHT_URGENCY=0.30
WEIGHT_WEAKNESS=0.25
WEIGHT_CONFIDENCE=0.20
WEIGHT_PREREQUISITE=0.15
WEIGHT_RECENCY=0.10

# Schedulers (in-process node-cron)
ENABLE_SCHEDULERS=true
WEEKLY_DIGEST_CRON=0 20 * * 0
SCHEDULER_TIMEZONE=UTC

# LeetCode (Phase 5) — public profile stats via GraphQL
LEETCODE_USERNAME=

# GitHub solutions sync (Phase 5)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_SOLUTIONS_PATH=leetcode
